PORT=8080
ENV=development

# Supabase Postgres Connection String
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Supabase API & Storage Configuration
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=kyc-documents

# JWT Secret Key for Auth Sessions
JWT_SECRET=your_production_jwt_secret_min_32_chars

# ZegoCloud Server Credentials
ZEGO_APP_ID=your_zegocloud_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret_32_bytes

# Cashfree PG, Secure ID & Payouts v2
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
CASHFREE_WEBHOOK_KEY=your_cashfree_webhook_key
CASHFREE_SANDBOX=true

# OTP Provider (mock / twilio / msg91)
OTP_PROVIDER=mock
OTP_MOCK_MODE=true

# SMS Providers (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# MSG91 SendOTP Android Widget. The Android apps hold their widget ID and
# mobile-integration token; the backend needs only this server-only key.
MSG91_SERVER_AUTH_KEY=

# Optional role-specific server auth keys override MSG91_SERVER_AUTH_KEY.
MSG91_CUSTOMER_SERVER_AUTH_KEY=
MSG91_LISTENER_SERVER_AUTH_KEY=

# Legacy direct widget verification. Leave unset when using the access-token
# flow above, which does not require mobile widget credentials in the backend.
MSG91_WIDGET_ID=
MSG91_WIDGET_AUTH_TOKEN=
MSG91_CUSTOMER_WIDGET_ID=
MSG91_CUSTOMER_WIDGET_AUTH_TOKEN=
MSG91_LISTENER_WIDGET_ID=
MSG91_LISTENER_WIDGET_AUTH_TOKEN=

# Cryptographic Keys (Must be exactly 32 bytes)
ENCRYPTION_KEY=your_32_byte_aes_encryption_key!
HMAC_KEY=your_32_byte_hmac_secret_key!!
